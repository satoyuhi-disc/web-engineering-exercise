# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored and must never be committed.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave unset for local SQLite. In production (e.g. Render), set this to
# the Postgres connection string provided by the hosting platform:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
